[Unit]
Description=Nano Influencer Python FastAPI Backend
After=network.target

[Service]
User=root
WorkingDirectory=/root/affiliate_python_backend
ExecStart=/root/affiliate_python_backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target